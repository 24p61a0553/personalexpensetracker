# =====================================================================
# Personal Expense Tracker - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and provide your database credentials.
# The '.env' file is excluded by .gitignore and will NEVER be committed.
#
# On cloud platforms (e.g. Render, Railway), configure these as
# platform environment variables in the web service settings.
# =====================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=your_db_username
DB_PASS=your_db_password
DB_SSL=false

# Alternative: Single unified database connection URI
# DATABASE_URL=mysql://your_db_username:your_db_password@localhost:3306/expense_tracker
